{
	"compilerOptions": {
		"module": "esnext",
		"moduleResolution": "bundler",
		"target": "esnext",
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"checkJs": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"types": ["svelte"]
	},
	"include": ["src/**/*.js", "src/**/*.d.ts", "src/**/*.svelte"]
}
