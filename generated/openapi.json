        ],
        "operationId": "revoke_ingress_credentials",
        "responses": {
          "204": {
            "description": "Ingress credentials revoked"
          },
          "500": {
            "description": "Failed to clear credentials"
          }
        }
      }
    },
    "/api/admin/twitch/auth": {
      "get": {
