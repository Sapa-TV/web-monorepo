      },
      "post": {
        "tags": [
          "queue"
        ],
        "operationId": "dequeue_next",
        "responses": {
          "200": {
            "description": "Spin started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NextResponse"
                }
              }
            }
          },
          "404": {
            "description": "No pending or error entries"
          },
          "409": {
            "description": "A spin is already active"
          },
          "422": {
            "description": "No slots configured"
          }
        }
      }
    },
