      "get": {
        "tags": [
          "queue"
        ],
        "operationId": "peek_next",
        "responses": {
          "200": {
            "description": "Next entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/QueueEntryResponse"
