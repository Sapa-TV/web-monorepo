          "400": {
            "description": "Twitch not configured"
          }
        }
      }
    },
    "/api/admin/twitch/auth/callback": {
      "get": {
        "tags": [
          "admin"
        ],
        "operationId": "twitch_auth_callback",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token exchanged and refresh token persisted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TwitchAuthCallbackResponse"
                }
              }
            }
          },
          "400": {
            "description": "Twitch not configured"
          },
          "403": {
            "description": "CSRF state mismatch or flow never started"
          }
        }
      }
