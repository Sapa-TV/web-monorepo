# Copy to .env.dev (dev) or .env / decrypt via `just decrypt-env` (prod).
# Backend reads config from: .env -> config.toml -> environment variables.
# Nested Twitch keys are upper-cased with "__" separators.

# Server
PORT=3000

# Optional (defaults shown). Keys mirror backend runtime config.
# CORS_ORIGINS=https://your.domain.com
# COOKIE_SECURE=true
# SESSION_TTL_SECS=86400
# RETENTION_SECS=86400
# QUEUE_CLEANUP_INTERVAL_SECS=3600
# SESSIONS_CLEANUP_INTERVAL_SECS=3600
# QUEUE_DEFAULT_LIMIT=20
# ROULETTE_TIMEOUT_SECS=10

# Twitch integration (needed for /api/auth/twitch login). Omit the block to disable twitch login.
TWITCH__CLIENT_ID=
TWITCH__CLIENT_SECRET=
TWITCH__BROADCASTER_ID=
TWITCH__REDIRECT_URI=http://localhost:5173/admin/login
TWITCH__CSRF_TTL_SECS=600