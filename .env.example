# Copy to .env.dev (dev) or edit .env and encrypt via `just encrypt-env` (prod).
# Backend reads config from: .env -> config.toml -> environment variables.
# Nested Twitch keys are upper-cased with "__" separators.

# Server
PORT=3000

# Extra admins (NON-root) seeded at startup (comma-separated twitch user ids).
# Root is seeded only from TWITCH__BROADCASTER_ID.
# Removing an id here does NOT remove the admin row; delete it via the admin panel.
# ADMIN_TWITCH_IDS=123,456

# Optional (defaults shown). Keys mirror backend runtime config.
# CORS_ORIGINS=https://your.domain.com
# COOKIE_SECURE=true
# SESSION_TTL_SECS=86400
# GUEST_SESSION_TTL_SECS=31536000
# RETENTION_SECS=86400
# QUEUE_CLEANUP_INTERVAL_SECS=3600
# SESSIONS_CLEANUP_INTERVAL_SECS=3600
# QUEUE_DEFAULT_LIMIT=20
# ROULETTE_TIMEOUT_SECS=10

# Twitch integration (needed for /api/auth/twitch login). Omit the block to disable twitch login.
TWITCH__CLIENT_ID=
TWITCH__CLIENT_SECRET=
TWITCH__BROADCASTER_ID=
TWITCH__REDIRECT_URI=http://localhost:5173/login-callback/twitch
TWITCH__CREDENTIALS_REDIRECT_URI=http://localhost:5173/creds-callback/twitch
# Optional, default 600:
# TWITCH__CSRF_TTL_SECS=600

# Vk video live integration (needed for /api/auth/vk-video-live login). Omit the block to disable vk video live login.
VK_VIDEO_LIVE__CLIENT_ID=
VK_VIDEO_LIVE__CLIENT_SECRET=
VK_VIDEO_LIVE__CHANNEL_URL=
VK_VIDEO_LIVE__REDIRECT_URI=http://localhost:5173/login-callback/vk-video-live
VK_VIDEO_LIVE__CREDENTIALS_REDIRECT_URI=http://localhost:5173/creds-callback/vk-video-live
# Optional, default 600:
# VK_VIDEO_LIVE__CSRF_TTL_SECS=600

# Google Sheets sync/import (orders directory). Omit to disable.
# Service account JSON key, base64-encoded (single line; the spreadsheet must be
# shared with the service account email). Encode once:
#   PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("key.json"))
#   bash: base64 -w0 key.json
# GOOGLE_SERVICE_ACCOUNT_KEY_BASE64=
# GOOGLE_SPREADSHEET_ID=

# SRS (RTMP) stream status. Omit SRS_HOOK_SECRET to reject hook calls;
# omit SRS_API_URL to disable polling of the SRS HTTP API.
# SRS_HOOK_SECRET=
# SRS_API_URL=http://srs:1985

# SITE_URL=https://sapa-tv.ru
# VAPID_SUBJECT=mailto:admin@sapa-tv.ru
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
