# Copy this file to /srv/web-app/app/.env on the VPS and fill in real values.
# Backend reads config from: .env (first) -> config.toml -> environment variables.


# Optional (defaults shown). Keys mirror backend/src/config/common.rs.
# PORT=3000
# CORS_ORIGINS=https://your.domain.com
# SESSION_TTL_SECS=86400
# COOKIE_SECURE=true

# Twitch integration. Nested keys are upper-cased with "__" separators.
# Omit the whole block if the app runs without Twitch.
# TWITCH__CLIENT_ID=
# TWITCH__CLIENT_SECRET=
# TWITCH__REFRESH_TOKEN=
# TWITCH__BROADCASTER_ID=
# TWITCH__REDIRECT_URI=
# TWITCH__CSRF_TTL_SECS=600
